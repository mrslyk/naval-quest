# Naval Quest — environment (Netlify / local)

# Client (Vite — exposed to browser)
VITE_SLYK_DASHBOARD_URL=https://naval.slyk.io/dashboard?locale=en
VITE_SLYK_PAYSPACE_ORIGIN=https://naval.slyk.io
VITE_SLYK_API_HOST=api.slyk.io

# Server (never expose to client)
SLYK_API_KEY=your_slyk_api_key
SLYK_API_HOST=api.slyk.io
SLYK_PAYSPACE_ORIGIN=https://naval.slyk.io
SLYK_PAYSPACE_SLUG=naval

# Stripe — patron sponsorship on navalgame.netlify.app (live keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Economy (asset code stays nvl; UI shows NAV)
NAVAL_REWARD_ASSET=nvl
NAVAL_REWARD_SYMBOL=NAV
NAVAL_LEVEL_REWARD_AMOUNT=10
NAVAL_GAME_ORIGIN=https://navalgame.netlify.app

# Optional email confirmations for legacy fund intents
# RESEND_API_KEY=re_...
# FUND_EMAIL_FROM=Naval Quest <fund@naval.slyk.io>
# FUND_SUPPORT_EMAIL=plg@slyk.io
